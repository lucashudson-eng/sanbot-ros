  <gazebo reference="camera_chin_link">
    <sensor type="camera" name="camera_chin">
      <pose>0 0 0 -1.5708 1.5708 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
