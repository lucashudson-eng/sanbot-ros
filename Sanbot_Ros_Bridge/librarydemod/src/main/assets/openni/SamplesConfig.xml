<OpenNI>

    <Licenses>

        <!--
        Add application-specific licenses here 
		<License vendor="vendor" key="key"/>
        -->
    </Licenses>

    <Log
        writeToAndroidLog="true"
        writeToConsole="false"
        writeToFile="false" >

        <!-- 0 - Verbose, 1 - Info, 2 - Warning, 3 - Error (default) -->

        <LogLevel value="1" />

        <Masks>

            <Mask
                name="ALL"
                on="true" />
        </Masks>

        <Dumps>
        </Dumps>
    </Log>

    <ProductionNodes>

        <!--
        Uncomment following line, in order to run from a recording 
		<Recording file="sampleRec.oni" />
        -->


        <!-- Set global mirror -->

        <GlobalMirror on="true" />

        <!-- Create a depth node and give it a name alias (useful if referenced ahead in this script) -->

        <Node name="MyDepth" type="Depth">
            <Query/>
            <Configuration/>
        </Node>
        <!-- Color Image node created in native if available (XML Image can fail whole init). -->
    </ProductionNodes>

</OpenNI>