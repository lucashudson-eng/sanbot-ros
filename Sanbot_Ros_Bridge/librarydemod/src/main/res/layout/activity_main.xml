<?xml version="1.0" encoding="utf-8"?>
<!-- Controls left · live preview right · scrollable logs below. Bezel-safe for Nano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="8dp"
    android:paddingTop="28dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <!-- Header -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sanbot ROS Bridge"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF222222" />

            <TextView
                android:id="@+id/textViewVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#FF666666"
                android:textSize="11sp"
                android:text="—" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonGoHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:minHeight="44dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Home"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonHideKeypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:minHeight="44dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Hide keypad"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Close"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Main: controls | video -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false">

        <!-- LEFT: scrollable controls -->
        <ScrollView
            android:id="@+id/controlsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45"
            android:layout_marginEnd="8dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MQTT"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF222222"
                    android:paddingBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Namespace"
                    android:textSize="12sp"
                    android:textColor="#FF666666" />

                <EditText
                    android:id="@+id/editTextName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="(optional)"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Broker IP"
                    android:textSize="12sp"
                    android:textColor="#FF666666" />

                <EditText
                    android:id="@+id/editTextIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="192.168.x.x"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Port"
                    android:textSize="12sp"
                    android:textColor="#FF666666" />

                <EditText
                    android:id="@+id/editTextPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1883"
                    android:hint="1883"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="44dp"
                    android:text="Connect"
                    android:textSize="15sp" />

                <!-- RTMP first so Nano keyboard cannot bury the stream switch. -->
                <Switch
                    android:id="@+id/switchRtmp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="RTMP ON/OFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonHdSpike"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="40dp"
                    android:text="HD spike stills"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Options"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF222222"
                    android:paddingBottom="2dp" />

                <CheckBox
                    android:id="@+id/checkBoxAutoConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Auto-connect on launch"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/checkBoxAutoLaunch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Auto-launch on boot"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switchWsControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="WS control :8080"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switchAutoStartProxy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Auto-start OpenSDK Proxy"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switchOpenProxyOnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:checked="false"
                    android:text="Open Proxy when app connects"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonStartProxy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="40dp"
                    android:text="Start OpenSDK Proxy"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switchTtsType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TTS Android (SDK unchecked)"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Language"
                    android:textSize="12sp"
                    android:textColor="#FF666666" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/language_array" />

                <CheckBox
                    android:id="@+id/checkBoxAutoReturnHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="false"
                    android:text="Auto Return to Home Screen"
                    android:textSize="13sp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seconds:"
                        android:textSize="13sp"
                        android:textColor="#FF222222"
                        android:paddingEnd="6dp" />

                    <EditText
                        android:id="@+id/editTextAutoReturnSeconds"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text="60"
                        android:textSize="13sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkBoxShowLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="false"
                    android:text="Show UI log"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Log filter"
                    android:textSize="12sp"
                    android:textColor="#FF666666"
                    android:layout_marginTop="2dp" />

                <Spinner
                    android:id="@+id/spinnerTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/topics_array" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/buttonClear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="40dp"
                        android:text="Clear"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/buttonGoHomeBottom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="40dp"
                        android:text="Home"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/buttonHideKeypadBottom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="40dp"
                        android:text="Keypad"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/buttonCloseBottom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="Close"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- RIGHT: live preview -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:background="#FF111111">

            <!-- TextureView: same SurfaceTexture feeds HAL preview + RTMP NV21 callbacks.
                 SurfaceView+setPreviewDisplay broke H264 publish (AAC-only on MediaMTX). -->
            <TextureView
                android:id="@+id/textureViewPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/textViewPreviewHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="RTMP Off\nTurn RTMP On for live preview"
                android:textColor="#FFAAAAAA"
                android:textSize="14sp"
                android:background="#CC111111" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom: always-visible scrollable logs -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Log"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FF444444" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:fillViewport="false"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:background="#FFF5F5F5"
        android:padding="6dp">

        <TextView
            android:id="@+id/textViewMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:textColor="#FF222222"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
